# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NOMBRE=euroamericano
DB_USUARIO=root
DB_CLAVE=""

# Acceso al panel de administración.
# El hash se genera con:  php bin/generar-clave.php "tu-contraseña"
PANEL_USUARIO=admin
PANEL_CLAVE_HASH=""

# URL pública del backend. Se usa para armar las URLs de las fotos
# que consume el sitio Next.js.
APP_URL=http://localhost:8000

# Carpeta donde se guardan las fotos, relativa a backend/.
# Tiene que estar dentro de public/ para que el servidor pueda servirlas.
UPLOADS_DIR=public/uploads

# Sitio Next.js al que avisar cuando cambian las actividades, para que deje
# de mostrar la versión guardada en caché. SITIO_TOKEN tiene que coincidir
# con REVALIDATE_TOKEN del sitio. Si se dejan vacíos, el aviso no se envía
# y el sitio se actualiza solo una vez por hora.
SITIO_URL=http://localhost:3000
SITIO_TOKEN=""
