# URL del backend PHP que publica las actividades (ver backend/README.md).
# Tiene que estar corriendo para que /actividades y el carrusel del home
# muestren contenido.
BACKEND_URL=http://localhost:8000

# Clave compartida con el backend. La usa para avisar por POST a
# /api/revalidar cuando se publica una actividad, y así el sitio deja de
# mostrar la versión guardada en caché. Generá una con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
REVALIDATE_TOKEN=
